              "mode": "raw",
              "raw": "{\"addressId\":\"{{addressId}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/shipping/rates"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Shipping rates returned', () => pm.response.to.have.status(200));",
                  "const rates = pm.response.json().data.rates;",
                  "pm.expect(rates).to.be.an('array');",
                  "if (rates.length) { pm.expect(rates[0]).to.have.property('service'); pm.expect(Number(rates[0].amount)).to.be.at.most(Number(rates[rates.length - 1].amount)); }",
                  "if (rates.length) pm.collectionVariables.set('shippingRateId', rates[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
