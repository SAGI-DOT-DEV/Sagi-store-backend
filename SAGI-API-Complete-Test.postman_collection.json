  "item": [
    {
      "name": "1. Health and login",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer login succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeded', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.user.role).to.eql('ADMIN');",
                  "pm.collectionVariables.set('adminAccessToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Categories, products, search and uploads",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fresh Test Category\",\n  \"slug\": \"fresh-test-{{$guid}}\",\n  \"description\": \"Collection test category\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('categoryId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cloudinary upload signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/v1/uploads/products/cloudinary-signature"
          }
        },
        {
          "name": "Create product with variant and image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fresh Test Product\",\n  \"slug\": \"fresh-product-{{$guid}}\",\n  \"description\": \"API test product\",\n  \"status\": \"ACTIVE\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"images\": [{\"url\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\", \"alt\": \"Test image\", \"position\": 0}],\n  \"variants\": [{\"sku\": \"FRESH-{{$guid}}\", \"name\": \"Standard\", \"price\": 19.99, \"weightGrams\": {{weightGrams}}, \"lengthCm\": {{lengthCm}}, \"widthCm\": {{widthCm}}, \"heightCm\": {{heightCm}}, \"inventory\": {\"quantity\": 10}}]\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('weightGrams', Math.floor(Math.random()*1751)+250);",
                  "pm.variables.set('lengthCm', Math.floor(Math.random()*51)+10);",
                  "pm.variables.set('widthCm', Math.floor(Math.random()*31)+10);",
                  "pm.variables.set('heightCm', Math.floor(Math.random()*26)+5);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List/search/filter products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products?q=Fresh&sort=price&order=asc&page=1&limit=20"
          }
        },
        {
          "name": "Get product and save variant",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('variantId', pm.response.json().data.variants[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Updated by fresh collection\"}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        }
      ]
    },
