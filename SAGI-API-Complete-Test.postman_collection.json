    {
      "name": "6. Admin order fulfillment status flow",
      "description": "Run after Stripe marks the order PAID. Execute statuses in order: PROCESSING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED.",
      "item": [
        {
          "name": "Admin set order status to PROCESSING",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
