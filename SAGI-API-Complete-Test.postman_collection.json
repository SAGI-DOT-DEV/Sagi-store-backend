    },
    {
      "key": "customerPassword",
      "value": "Passw0rd!123"
    },
    {
      "key": "adminEmail",
      "value": "lilrichie5537@gmail.com"
    },
    {
      "key": "adminPassword",
      "value": "Passw0rd!123"
    },
    {
      "key": "accessToken",
