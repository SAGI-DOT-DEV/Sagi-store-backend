{
  "info": {
    "name": "SAGI All Implemented API Tests",
    "description": "End-to-end Postman requests for implemented SAGI backend routes. Run requests in order where variables are produced by test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "test",
    "script": { "type": "text/javascript", "exec": [
      "pm.test('Request succeeded', () => pm.expect(pm.response.code).to.be.below(400));",
      "if (pm.response.text()) { const body = pm.response.json(); pm.expect(body.success).to.eql(true); }"
    ] }
  }],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "customerEmail", "value": "" },
    { "key": "customerPassword", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "verificationToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "variantId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health and authentication",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
        { "name": "Register customer (optional)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Customer\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/register" } },
        { "name": "Verify customer email", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/verify-email" } },
        { "name": "Login customer", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/login" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Customer login succeeded', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken);"] } }] },
        { "name": "Login admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/login" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin login succeeded', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data.user.role).to.eql('ADMIN');", "pm.collectionVariables.set('adminAccessToken', pm.response.json().data.accessToken);"] } }] },
        { "name": "Customer profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/auth/me" } },
        { "name": "Logout customer", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/auth/logout" } }
      ]
    },
    {
      "name": "Catalog and uploads",
      "item": [
        { "name": "List categories", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" } },
        { "name": "Create category", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Category\",\n  \"slug\": \"postman-category-{{$guid}}\",\n  \"description\": \"API test category\"\n}" }, "url": "{{baseUrl}}/api/v1/categories" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('categoryId', pm.response.json().data.id);"] } }] },
        { "name": "Get Cloudinary upload signature", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/v1/uploads/products/cloudinary-signature" } },
        { "name": "Create active product", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Product\",\n  \"slug\": \"postman-product-{{$guid}}\",\n  \"description\": \"API test product\",\n  \"status\": \"ACTIVE\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"variants\": [{\n    \"sku\": \"POSTMAN-SKU-{{$guid}}\",\n    \"name\": \"Standard\",\n    \"price\": 19.99,\n    \"inventory\": { \"quantity\": 10 }\n  }]\n}" }, "url": "{{baseUrl}}/api/v1/products" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('productId', pm.response.json().data.id);"] } }] },
        { "name": "List/search/filter products", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products?q=Postman&sort=price&order=asc&page=1&limit=20" } },
        { "name": "Get product detail and save variant", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/{{productId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('variantId', pm.response.json().data.variants[0].id);"] } }] },
        { "name": "Update product", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated by Postman\"\n}" }, "url": "{{baseUrl}}/api/v1/products/{{productId}}" } }
      ]
    },
    {
      "name": "Distributor, cart, orders, payments, reviews",
      "item": [
        { "name": "Distributor signup", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Distributor\",\n  \"phone\": \"+14165551234\",\n  \"email\": \"distributor-{{$guid}}@example.com\"\n}" }, "url": "{{baseUrl}}/api/v1/distributors/signup" } },
        { "name": "Add item to cart", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": 1\n}" }, "url": "{{baseUrl}}/api/v1/cart/items" } },
        { "name": "Read cart", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/cart" } },
        { "name": "Create order", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/v1/orders" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('orderId', pm.response.json().data.id);"] } }] },
        { "name": "Purchase history", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/orders/purchase-history" } },
        { "name": "Create Stripe checkout (new test key)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Idempotency-Key", "value": "checkout-{{$guid}}" }], "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}" }, "url": "{{baseUrl}}/api/v1/payments/checkout" } },
        { "name": "Verify paid order after browser checkout", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/orders/{{orderId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Order request succeeded', () => pm.response.to.have.status(200));", "pm.test('Webhook marked order paid', () => pm.expect(pm.response.json().data.status).to.eql('PAID'));" ] } }] },
        { "name": "Read experience review", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/reviews/experience?orderId={{orderId}}" } },
        { "name": "Submit experience review (after delivery)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"deliveryRating\": 5,\n  \"checkoutRating\": 5,\n  \"overallRating\": 5,\n  \"comment\": \"Postman test review\"\n}" }, "url": "{{baseUrl}}/api/v1/reviews/experience" } }
      ]
    },
    {
      "name": "Admin operations and reports",
      "item": [
        { "name": "Save shipping settings", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"freeShippingThreshold\": 100,\n  \"currency\": \"CAD\",\n  \"shipFromName\": \"SAGI Warehouse\",\n  \"shipFromStreet1\": \"123 Main Street\",\n  \"shipFromCity\": \"Toronto\",\n  \"shipFromState\": \"ON\",\n  \"shipFromPostalCode\": \"M5V 2T6\",\n  \"shipFromCountry\": \"CA\"\n}" }, "url": "{{baseUrl}}/api/v1/admin/shipping-settings" } },
        { "name": "Read shipping settings", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/shipping-settings" } },
        { "name": "Adjust inventory", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"change\": 5,\n  \"reason\": \"Postman inventory test\"\n}" }, "url": "{{baseUrl}}/api/v1/admin/inventory/{{variantId}}/adjust" } },
        { "name": "Sales report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/reports/sales" } },
        { "name": "Product performance report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/reports/product-performance?limit=10" } },
        { "name": "List distributors", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/distributors" } },
        { "name": "Search transactions", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/transactions?q={{orderId}}" } },
        { "name": "List Stripe events", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/stripe/events" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Stripe events request succeeded', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data).to.be.an('array');" ] } }] },
        { "name": "List backups", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/backups" } }
      ]
    }
  ]
}
