{
  "info": {
    "name": "SAGI Shipping Settings Tests",
    "description": "Postman tests for admin-managed Canadian ship-from address and free-shipping threshold.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "lilrichie5537@gmail.com" },
    { "key": "adminPassword", "value": "Passw0rd!123" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "freeShippingThreshold", "value": "100" }
  ],
  "item": [
    {
      "name": "1. Login admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Admin login succeeded', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body.data.user.role).to.eql('ADMIN');",
        "pm.collectionVariables.set('adminAccessToken', body.data.accessToken);"
      ] } }]
    },
    {
      "name": "2. Save Canadian shipping settings",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"freeShippingThreshold\": {{freeShippingThreshold}},\n  \"currency\": \"CAD\",\n  \"shipFromName\": \"SAGI Warehouse\",\n  \"shipFromCompany\": \"SAGI Online\",\n  \"shipFromPhone\": \"+14165551234\",\n  \"shipFromEmail\": \"warehouse@example.ca\",\n  \"shipFromStreet1\": \"123 Main Street\",\n  \"shipFromStreet2\": null,\n  \"shipFromCity\": \"Toronto\",\n  \"shipFromState\": \"ON\",\n  \"shipFromPostalCode\": \"M5V 2T6\",\n  \"shipFromCountry\": \"CA\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/shipping-settings"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Shipping settings saved', () => pm.response.to.have.status(200));",
        "const settings = pm.response.json().data;",
        "pm.expect(settings.currency).to.eql('CAD');",
        "pm.expect(Number(settings.freeShippingThreshold)).to.eql(Number(pm.variables.get('freeShippingThreshold')));",
        "pm.expect(settings.shipFromCountry).to.eql('CA');"
      ] } }]
    },
    {
      "name": "3. Read shipping settings",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
        "url": "{{baseUrl}}/api/v1/admin/shipping-settings"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Shipping settings returned', () => pm.response.to.have.status(200));",
        "const settings = pm.response.json().data;",
        "pm.expect(settings).to.not.be.null;",
        "pm.expect(settings.currency).to.eql('CAD');",
        "pm.expect(settings.shipFromCountry).to.eql('CA');"
      ] } }]
    },
    {
      "name": "4. Reject non-Canadian settings",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"freeShippingThreshold\": 100,\n  \"currency\": \"USD\",\n  \"shipFromName\": \"Invalid Warehouse\",\n  \"shipFromStreet1\": \"123 Main Street\",\n  \"shipFromCity\": \"Toronto\",\n  \"shipFromPostalCode\": \"M5V 2T6\",\n  \"shipFromCountry\": \"US\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/shipping-settings"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Invalid country/currency rejected', () => pm.response.to.have.status(400));",
        "pm.expect(pm.response.json().success).to.eql(false);"
      ] } }]
    },
    {
      "name": "5. Reject unauthenticated access",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/admin/shipping-settings"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Unauthenticated request rejected', () => pm.response.to.have.status(401));",
        "pm.expect(pm.response.json().success).to.eql(false);"
      ] } }]
    },
    {
      "name": "6. Reject negative free-shipping threshold",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"freeShippingThreshold\": -1,\n  \"currency\": \"CAD\",\n  \"shipFromName\": \"SAGI Warehouse\",\n  \"shipFromStreet1\": \"123 Main Street\",\n  \"shipFromCity\": \"Toronto\",\n  \"shipFromPostalCode\": \"M5V 2T6\",\n  \"shipFromCountry\": \"CA\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/shipping-settings"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Negative threshold rejected', () => pm.response.to.have.status(400));",
        "pm.expect(pm.response.json().success).to.eql(false);"
      ] } }]
    }
  ]
}
