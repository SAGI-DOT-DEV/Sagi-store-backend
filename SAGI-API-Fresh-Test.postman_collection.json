{
  "info": {
    "name": "SAGI API - Fresh End-to-End Tests",
    "description": "Fresh collection for testing the implemented SAGI API. Run requests in order. The checkout request generates a unique Idempotency-Key for every run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "customerEmail",
      "value": "igwep5537@gmail.com"
    },
    {
      "key": "customerPassword",
      "value": "Passw0rd!123"
    },
    {
      "key": "adminEmail",
      "value": "lilrichie5537@gmail.com"
    },
    {
      "key": "adminPassword",
      "value": "Passw0rd!123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "variantId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "addressId",
      "value": ""
    },
    {
      "key": "shippingRateId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health and login",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer login succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeded', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.user.role).to.eql('ADMIN');",
                  "pm.collectionVariables.set('adminAccessToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Categories, products, search and uploads",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fresh Test Category\",\n  \"slug\": \"fresh-test-{{$guid}}\",\n  \"description\": \"Collection test category\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('categoryId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cloudinary upload signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/v1/uploads/products/cloudinary-signature"
          }
        },
        {
          "name": "Create product with variant and image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fresh Test Product\",\n  \"slug\": \"fresh-product-{{$guid}}\",\n  \"description\": \"API test product\",\n  \"status\": \"ACTIVE\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"images\": [{\"url\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\", \"alt\": \"Test image\", \"position\": 0}],\n  \"variants\": [{\"sku\": \"FRESH-{{$guid}}\", \"name\": \"Standard\", \"price\": 19.99, \"weightGrams\": {{weightGrams}}, \"lengthCm\": {{lengthCm}}, \"widthCm\": {{widthCm}}, \"heightCm\": {{heightCm}}, \"inventory\": {\"quantity\": 10}}]\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('weightGrams', Math.floor(Math.random()*1751)+250);",
                  "pm.variables.set('lengthCm', Math.floor(Math.random()*51)+10);",
                  "pm.variables.set('widthCm', Math.floor(Math.random()*31)+10);",
                  "pm.variables.set('heightCm', Math.floor(Math.random()*26)+5);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List/search/filter products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products?q=Fresh&sort=price&order=asc&page=1&limit=20"
          }
        },
        {
          "name": "Get product and save variant",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('variantId', pm.response.json().data.variants[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Updated by fresh collection\"}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "3. Cart, orders and Stripe checkout",
      "item": [
        {
          "name": "Add product to cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"variantId\":\"{{variantId}}\",\"quantity\":1}"
            },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        },
        {
          "name": "Read cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/cart"
          }
        },
        {
          "name": "Get Shippo shipping rates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"addressId\":\"{{addressId}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/shipping/rates"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Shipping rates returned', () => pm.response.to.have.status(200));",
                  "const rates = pm.response.json().data.rates;",
                  "pm.expect(rates).to.be.an('array');",
                  "if (rates.length) pm.collectionVariables.set('shippingRateId', rates[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/v1/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('orderId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Stripe checkout (unique key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "fresh-checkout-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\":\"{{orderId}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/payments/checkout"
          }
        },
        {
          "name": "Get order detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "Purchase history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/purchase-history"
          }
        }
      ]
    },
    {
      "name": "4. Reviews and distributor",
      "item": [
        {
          "name": "Read experience review",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/reviews/experience?orderId={{orderId}}"
          }
        },
        {
          "name": "Submit experience review (after delivery)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\":\"{{orderId}}\",\"deliveryRating\":5,\"checkoutRating\":5,\"overallRating\":5,\"comment\":\"Fresh collection test\"}"
            },
            "url": "{{baseUrl}}/api/v1/reviews/experience"
          }
        },
        {
          "name": "Distributor signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"Fresh\",\"lastName\":\"Distributor\",\"phone\":\"+14165551234\",\"email\":\"fresh-distributor-{{$guid}}@example.com\"}"
            },
            "url": "{{baseUrl}}/api/v1/distributors/signup"
          }
        }
      ]
    },
    {
      "name": "5. Admin settings, inventory and reports",
      "item": [
        {
          "name": "Save Canadian shipping settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"freeShippingThreshold\":100,\"currency\":\"CAD\",\"shipFromName\":\"SAGI Warehouse\",\"shipFromStreet1\":\"123 Main Street\",\"shipFromCity\":\"Toronto\",\"shipFromState\":\"ON\",\"shipFromPostalCode\":\"M5V 2T6\",\"shipFromCountry\":\"CA\"}"
            },
            "url": "{{baseUrl}}/api/v1/admin/shipping-settings"
          }
        },
        {
          "name": "Read shipping settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/shipping-settings"
          }
        },
        {
          "name": "Adjust inventory",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"change\":5,\"reason\":\"Fresh collection test\"}"
            },
            "url": "{{baseUrl}}/api/v1/admin/inventory/{{variantId}}/adjust"
          }
        },
        {
          "name": "Sales report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/reports/sales"
          }
        },
        {
          "name": "Product performance report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/reports/product-performance?limit=10"
          }
        },
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/transactions?q={{orderId}}"
          }
        },
        {
          "name": "List Stripe events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/stripe/events"
          }
        },
        {
          "name": "List backups",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/backups"
          }
        }
      ]
    }
  ]
}
