NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sagi?schema=public
BACKUP_DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
SHIPPO_API_KEY=shippo_test_replace_me
CHECKOUT_RESERVATION_MINUTES=30
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
# Gmail App Password is required for verification emails. EMAIL_FROM must be the Gmail account or a verified Gmail "Send mail as" alias.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
EMAIL_FROM="SAGI <your-gmail-address@gmail.com>"
# Copy these values from your Cloudinary Console. Never expose CLOUDINARY_API_SECRET in a frontend app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=sagi/products
SWAGGER_ENABLED=true
BACKUP_ENABLED=false
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=UTC
# Share the target Drive folder with this service account. Do not commit these secrets.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Exactly 32 random bytes, base64 encoded (example: openssl rand -base64 32)
BACKUP_ENCRYPTION_KEY_BASE64=
